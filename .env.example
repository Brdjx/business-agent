# Copy this file to .env and fill in the blanks:
#
#   cp .env.example .env
#
# .env is gitignored; this file is not. Every value below that is filled in
# already is a dev-only default that works against `npm run db:up` — the blanks
# are the ones only you can supply.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# The compose service in docker-compose.yml. Host port 5433 rather than 5432,
# because a developer very often already has something on 5432 and the failure
# mode is connecting to the wrong database rather than failing to connect —
# see the comment on the port mapping in docker-compose.yml.
DATABASE_URL=postgres://business_agent:business_agent@localhost:5433/business_agent

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------

# The agent's own reasoning. Required for anything that runs the loop; the
# unit tests do not need it, because a test that spends money on every commit
# stops being run.
#
# There is no provider SDK in the dependency list. The adapter posts to
# /v1/messages with fetch, so this key is sent as the x-api-key header and
# nothing else reads it.
ANTHROPIC_API_KEY=

# Optional, and genuinely optional: nothing reads it yet. Reserved for a second
# provider adapter, so that two models disagreeing about the same records is
# something the eval suite can record rather than something you have to take on
# faith. Leaving it unset changes no behaviour.
OPENAI_API_KEY=

# Which model answers. Kept in the environment rather than a constant because
# a regression after a model change and a regression after a prompt change are
# different investigations, and telling them apart later means being able to
# say which model produced a given run.
#
# This is an Anthropic API model id. Ids from a cloud provider's namespace
# (us.anthropic.claude-..., anthropic.claude-...) come back from /v1/messages
# as a 404 not_found_error, which reads like a wrong endpoint rather than a
# wrong model name.
MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# The operator
# ---------------------------------------------------------------------------

# The single person whose business this is.
#
# Every table is scoped by user_id and every read the agent makes is filtered
# by it. That is not multi-tenancy ambition — it is that an unscoped query is
# the specific bug that answers a question about the wrong business, and a
# scope that must be passed in cannot be forgotten as quietly as one that
# defaults to "everything".
#
# This value MUST match the operator row in db/900-seed.sql. If they disagree
# the agent connects, queries successfully, finds nothing, and reports that the
# business has no clients — a silent empty result rather than an error.
#
# Deliberately not a random uuid: an obviously synthetic one is recognisable as
# fixture data in a log line, where a real-looking uuid invites the assumption
# that it came from somewhere.
USER_ID=00000000-0000-4000-8000-000000000001

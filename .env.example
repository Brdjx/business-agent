# Copy this file to .env and fill in the blanks:
#
#   cp .env.example .env
#
# .env is gitignored; this file is not. Every value below that is filled in
# already is a dev-only default that works against `npm run db:up` — the blanks
# are the ones only you can supply.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# The compose service in docker-compose.yml. Host port 5433 rather than 5432,
# because a developer very often already has something on 5432 and the failure
# mode is connecting to the wrong database rather than failing to connect —
# see the comment on the port mapping in docker-compose.yml.
DATABASE_URL=postgres://business_agent:business_agent@localhost:5433/business_agent

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------

# The agent's own reasoning. Required for anything that runs the loop; the
# unit tests do not need it, because a test that spends money on every commit
# stops being run.
#
# There is no provider SDK in the dependency list. The adapter posts to
# /v1/messages with fetch, so this key is sent as the x-api-key header and
# nothing else reads it.
ANTHROPIC_API_KEY=

# Which adapter answers: anthropic (default) or bedrock.
#
# Two implementations exist because a one-implementation interface is an
# assumption rather than an abstraction — the boundary is only known to be in the
# right place once something else has been fitted through it. The Anthropic
# adapter is the one to use; Bedrock is here because it is what the private
# original runs on, and because it is what this port was verified against.
PROVIDER=anthropic

# Only for PROVIDER=bedrock. Credentials come from the AWS SDK's normal chain
# (AWS_PROFILE, instance role, environment), so there is no key to paste here.
# The SDK itself is an optional dependency: running the Anthropic adapter never
# installs or imports it.
AWS_REGION=us-east-1

# Which model answers. Kept in the environment rather than a constant because
# a regression after a model change and a regression after a prompt change are
# different investigations, and telling them apart later means being able to
# say which model produced a given run.
#
# The id belongs to whichever PROVIDER is selected, and they are not
# interchangeable. An Anthropic API id looks like `claude-opus-5`; a Bedrock id
# looks like `us.anthropic.claude-sonnet-4-5-20250929-v1:0`. Crossing them fails
# in a way that reads as the wrong endpoint rather than the wrong model name: a
# namespaced id sent to /v1/messages comes back 404 not_found_error.
MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# The operator
# ---------------------------------------------------------------------------

# The single person whose business this is.
#
# Worth being precise about what this does and does not scope, because guessing
# wrong sends you looking in the wrong place:
#
#   The BUSINESS tables — clients, contacts, projects, invoices, time_entries —
#   have no user_id at all. There is one operator, and inventing a column to
#   hold the same value in every row would be pure ceremony.
#
#   The AGENT tables — agent_runs, agent_proposals, agent_write_keys,
#   agent_memory — do carry user_id, and it comes from here. So this value
#   decides whose runs, whose pending approvals and whose notes are read back.
#   Point it at a different uuid and the business answers are identical while
#   the history and the approval queue appear empty.
#
# It therefore does NOT need to match anything in db/900-seed.sql; the seed
# contains business records only. Any uuid works, and consistency between runs is
# the only thing that matters.
#
# Deliberately not a random uuid: an obviously synthetic one is recognisable as
# fixture data in a log line, where a real-looking uuid invites the assumption
# that it came from somewhere.
#
# What would change for more than one operator is written up in docs/design.md
# under "what is deliberately not here".
USER_ID=00000000-0000-4000-8000-000000000001
